-- proved by proof search (final run (current code, 10 s per lemma), 52 ms)
\lemma not-isInv {b : Bool} : not (not b) = b \elim b   | false => idp   | true => idp
-- proved by proof search (final run (current code, 10 s per lemma), 2 ms)
\lemma true/=false (p : true = false) : Empty => contradiction
