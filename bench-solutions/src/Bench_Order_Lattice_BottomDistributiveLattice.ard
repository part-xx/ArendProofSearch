-- proved by proof search (final run (current code, 10 s per lemma), 73 ms)
\lemma bottom-ldistr {A : BottomDistributiveLattice} {x : A} : x ∧ bottom = bottom => MeetSemilattice.meet-comm *> BottomDistributiveLattice.bottom-rdistr
-- proved by proof search (final run (current code, 10 s per lemma), 57 ms)
\lemma bottom-rdistr {A : BottomDistributiveLattice} {x : A} : bottom ∧ x = bottom => MeetSemilattice.meet_<= bottom-univ
