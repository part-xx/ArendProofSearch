\lemma suc_pred {n : Nat} (n/=0 : n /= 0) : suc (pred n) = n => triEquals (\case \elim n, \elim n/=0 \with {  | zero, n/=0 => contradiction  | suc n, n/=0 => Arith.Int.IntRing.minus__})
