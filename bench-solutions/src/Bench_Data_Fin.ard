-- proved by proof search (final run (current code, 10 s per lemma), 46 ms)
\lemma unfsuc {n : Nat} {x y : Fin n} (p : suc x = suc y) : x = y => Set.Fin.FinSet.suc-isInj _ _ p
-- proved by proof search (final run (current code, 10 s per lemma), 80 ms)
\lemma fsuc/= {n : Nat} {x y : Fin n} (p : x /= y) : fsuc x /= fsuc y \elim n, x, y, p   | zero, x, y, p => \lam p' => contradiction   | suc n, x, y, p => \lam p' => p (Data.Fin.unfsuc p')
-- proved by proof search (final run (current code, 10 s per lemma), 2 ms)
\lemma fsuc/=0 {n : Nat} {x : Fin n} : fsuc x /= 0 => contradiction
-- proved by proof search (final run (current code, 10 s per lemma), 231 ms)
\lemma fsuc/=-conv {n : Nat} {x y : Fin n} (p : fsuc x /= fsuc y) : x /= y \elim n, x, y, p   | zero, x, y, p => \lam p' => contradiction   | suc n, zero, zero, p => \lam p' => contradiction   | suc n, zero, suc y, p => \lam p' => contradiction   | suc n, suc x, y, p => \lam p' => p (rewrite p' idp)
-- proved by proof search (final run (current code, 10 s per lemma), 39 ms)
\lemma nat_fin_= {n : Nat} {x y : Fin n} (p : x = {Nat} y) : x = y => Arith.Nat.fin_nat-inj p
-- proved by proof search (final run (current code, 10 s per lemma), 78 ms)
\lemma fin_nat_/= {n : Nat} {x y : Fin n} (p : x /= y) : (x : Nat) /= y \elim n, x, y, p   | zero, x, y, p => contradiction   | suc n, x, y, p => \lam p' => p (Data.Fin.nat_fin_= p')
-- proved by proof search (final run (current code, 10 s per lemma), 100 ms)
\lemma fsuc_fpred {n : Nat} {x : Fin (suc n)} {d : Fin n} (p : x /= 0) : fsuc (fpred d x) = x \elim x, p   | zero, p => contradiction   | suc x, p => idp
-- proved by proof search (final run (current code, 10 s per lemma), 87 ms)
\lemma fsuc_fpredP {n : Nat} {x : Fin (suc n)} (p : x /= 0) : fsuc (fpredP x p) = x \elim x, p   | zero, p => contradiction   | suc x, p => idp
