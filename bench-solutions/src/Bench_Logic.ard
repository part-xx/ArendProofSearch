\lemma <->trans {P Q S : \Prop} (f : P <-> Q) (g : Q <-> S) : P <-> S => \case f \with {   | (p, p') => \case g \with {     | (p'', p''') => (\lam p'''' => p'' (p p''''), \lam p'''' => p' (p''' p''''))   } }
