\lemma SetIm_o {A B C : \Cat} {f : A -> B} {g : B -> C} {P : A -> \Prop} : SetIm (\lam x => g (f x)) P = SetIm g (SetIm f P) => ext (\lam b   => Logic.propExt (\lam p => (\case p \with {  | inP (a, x) => \case \elim a, \elim x \with {    | (a, p'), x => rewriteI x (Logic.SetIm-con (Logic.SetIm-con p'))  }}))     (\lam p => (\case p \with {  | inP (a, x) => \case \elim a, \elim x \with {    | (a, p'), x => \case p' \with {         | inP (a', x') => unfold SetIm (rewriteI x (rewriteI x' (Logic.TSetIm-con _)))    }  }})))
-- proved by proof search (final run (current code, 10 s per lemma), 121 ms)
\lemma SetIm_TSetIm {A B C : \Cat} {f : A -> B} {g : B -> C} : SetIm g (TSetIm f) = TSetIm (\lam a => g (f a)) => ext (\lam b => Logic.propExt (\lam p => (\case p \with {  | inP (a, x) => \case \elim a, \elim x \with {    | (a, p'), x => \case p' \with {       | inP (a', x') => rewriteI x (rewriteI x' (Logic.TSetIm-con _))    }  }}))   (\lam p => (\case p \with {  | inP (a, x) => rewriteI x (Logic.SetIm-con (Logic.TSetIm-con _))})))
-- proved by proof search (final run (current code, 10 s per lemma), 48 ms)
\lemma propExt {A B : \Prop} (f : A -> B) (g : B -> A) : A = B => ext (f, g)
