-- Lemmas of Set with the best proofs found by the proof search; unproved lemmas keep {?} (generated by solutions.py).

\import Data.Bool (Bool, So, false, not, true)
\import Function.Meta
\import Logic
\import Logic.Meta
\import Logic.Unique
\import Meta
\import Paths
\import Paths.Meta
\import Set
\import Algebra.Meta

-- proved by proof search (final run (current code, 10 s per lemma), 6 ms)
\lemma dec-separated {E : \Prop} (d : Dec E) (q : Not (Not E)) : E => \case d \with {   | yes p => p   | no p' => contradiction }
-- proved by proof search (final run (current code, 10 s per lemma), 257 ms)
\lemma negated-dec (E : \Prop) {P : NegatedProp} (f : Dec E -> P) : P => isNegated (\lam p => p (f (no (\lam p' => p (f (yes p'))))))
\lemma dec_decide {E : \Prop} (d : Dec E) : Decide E => {?}
-- proved by proof search (final run (current code, 10 s per lemma), 50 ms)
\lemma dec_yes_reduce {E : \Prop} {d : Dec E} (e : E) : d = yes e => prop-pi
-- proved by proof search (final run (current code, 10 s per lemma), 56 ms)
\lemma dec_no_reduce {E : \Prop} {d : Dec E} (q : Not E) : d = no q => prop-pi
-- proved by proof search (final run (current code, 10 s per lemma), 203 ms)
\lemma Dec_|| {A B : \Prop} (d : Dec A) (e : Dec B) : Dec (A || B) => \case d \with {   | yes p => yes (byLeft p)   | no p' => \case e \with {     | yes p => yes (byRight p)     | no p'' => no contradiction   } }
-- proved by proof search (final run (current code, 10 s per lemma), 18 ms)
\lemma NotDec {P : \Prop} (d : Dec P) : Dec (Not P) => \case d \with {   | yes p => no contradiction   | no p' => yes p' }
-- proved by proof search (final run (current code, 10 s per lemma), 62 ms)
\lemma decideEq=_reduce {A : DecSet} {x y : A} (p : x = y) : decideEq x y = yes p => Set.dec_yes_reduce _
-- proved by proof search (final run (current code, 10 s per lemma), 58 ms)
\lemma decideEq/=_reduce {A : DecSet} {x y : A} (p : x /= y) : decideEq x y = no p => prop-pi
\lemma ==_= {A : DecSet} {a a' : A} (so : So (a == a')) : a = a' => {?}
-- proved by proof search (final run (current code, 10 s per lemma), 42 ms)
\lemma =-dec {A : DecSet} {a a' : A} {so : So (a == a')} : a = a' => Set.==_= so
\lemma /=-dec {A : DecSet} {a a' : A} {so : So (not (a == a'))} : a /= a' => {?}
