-- Lemmas of Order.StrictOrder (class StrictPoset) with the best proofs found by the proof search; unproved lemmas keep {?} (generated by solutions.py).

\import Logic
\import Paths
\import Set
\import Order.StrictOrder
\import Algebra.Meta
\import Logic.Meta
\import Meta
\import Paths.Meta
\open StrictPoset

-- proved by proof search (final run (current code, 10 s per lemma), 1 ms)
\lemma <_/= {A : StrictPoset} {x y : A} (x<y : x < y) : x /= y => contradiction
-- proved by proof search (final run (current code, 10 s per lemma), 2 ms)
\lemma >_/= {A : StrictPoset} {x y : A} (y<x : x > y) : x /= y => contradiction
